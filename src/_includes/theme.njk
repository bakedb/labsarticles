{# =============================================================================
THEME / 5-COLOR PALETTE
-----------------------------------------------------------------------------
The site is built from five colors per mode:

1. --palette-page page background
2. --palette-surface cards, header, footer
3. --palette-surface-alt thumbnails and inset areas
4. --palette-text headings and primary copy
5. --palette-accent links, hovers, highlights

Edit those five values in `:root` (light) and `.dark` (dark). Every other
shade is derived from them automatically, so the templates never need to
change.

Any valid CSS color works (hex, rgb(), hsl(), oklch(), etc.).
============================================================================= #}
<style>
  :root {
    /* Light palette — change these five colors */
    --palette-page: #fef4ff;
    --palette-surface: #E3D3E4;
    --palette-surface-alt: #DC758F;
    --palette-text: #873D48;
    --palette-accent: #664C43;

    /* Derived semantic tokens — no need to edit */
    --color-page: var(--palette-page);
    --color-surface: var(--palette-surface);
    --color-surface-alt: var(--palette-surface-alt);
    --color-heading: var(--palette-text);
    --color-body: color-mix(in srgb, var(--palette-text) 82%, var(--palette-surface));
    --color-muted: color-mix(in srgb, var(--palette-text) 55%, var(--palette-surface));
    --color-subtle: color-mix(in srgb, var(--color-muted) 70%, var(--palette-page));
    --color-line: color-mix(in srgb, var(--palette-text) 12%, var(--palette-surface));
    --color-control: color-mix(in srgb, var(--palette-text) 6%, var(--palette-surface));
    --color-control-hover: color-mix(in srgb, var(--palette-text) 12%, var(--palette-surface));
    --color-brand: var(--palette-accent);
  }

  .dark {
    /* Dark palette — change these five colors */
    --palette-page: #716e71;
    --palette-surface: #6F6172;
    --palette-surface-alt: #5F404B;
    --palette-text: #35282B;
    --palette-accent: #2B2726;
  }
</style>

<script>
  tailwind.config = {
    darkMode: 'class',
    theme: {
      extend: {
        colors: {
          page: 'var(--color-page)',
          surface: 'var(--color-surface)',
          'surface-alt': 'var(--color-surface-alt)',
          heading: 'var(--color-heading)',
          body: 'var(--color-body)',
          muted: 'var(--color-muted)',
          subtle: 'var(--color-subtle)',
          line: 'var(--color-line)',
          control: 'var(--color-control)',
          'control-hover': 'var(--color-control-hover)',
          brand: 'var(--color-brand)',
        },
        typography: {
          DEFAULT: {
            css: {
              '--tw-prose-body': 'var(--color-body)',
              '--tw-prose-headings': 'var(--color-heading)',
              '--tw-prose-lead': 'var(--color-muted)',
              '--tw-prose-links': 'var(--color-brand)',
              '--tw-prose-bold': 'var(--color-heading)',
              '--tw-prose-counters': 'var(--color-subtle)',
              '--tw-prose-bullets': 'var(--color-subtle)',
              '--tw-prose-hr': 'var(--color-line)',
              '--tw-prose-quotes': 'var(--color-body)',
              '--tw-prose-quote-borders': 'var(--color-line)',
              '--tw-prose-captions': 'var(--color-subtle)',
              '--tw-prose-code': 'var(--color-heading)',
              '--tw-prose-pre-code': 'var(--color-body)',
              '--tw-prose-pre-bg': 'var(--color-surface-alt)',
              '--tw-prose-th-borders': 'var(--color-line)',
              '--tw-prose-td-borders': 'var(--color-line)',
            },
          },
        },
      },
    },
  }
</script>