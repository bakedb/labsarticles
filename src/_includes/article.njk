---
layout: base.njk
---
<article
  class="bg-surface rounded-xl shadow-sm border border-line overflow-hidden transition-colors duration-200">

  {% if cover %}
  <div class="w-full h-64 md:h-80 overflow-hidden bg-surface-alt">
    <img src="{{ cover | url }}" alt="{{ coverAlt or title }}" class="w-full h-full object-cover" />
  </div>
  {% endif %}

  <div class="p-8">
    <header class="mb-6">
      <h1 class="text-3xl font-extrabold text-heading mb-2 leading-tight">{{ title }}</h1>
      <time class="text-sm text-subtle font-medium">{{ date.toDateString() }}</time>
    </header>

    <div class="prose max-w-none leading-relaxed">
      {{ content | safe }}
    </div>

    <div class="mt-8 pt-6 border-t border-line">
      <a href="{{ '/' | url }}" class="text-sm font-semibold text-brand hover:underline">Back to
        Labs Feed</a>
    </div>
  </div>
</article>